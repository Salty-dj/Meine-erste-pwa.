{
  "name": "TSV Vereinsmanager",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-24-bookworm",
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "TSV Vereinsmanager",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm ci && npm run db:generate",
  "customizations": {
    "vscode": { "extensions": ["Prisma.prisma", "bradlc.vscode-tailwindcss"] }
  }
}
