# Local development only. Choose a strong, unique DB_PASSWORD before starting Docker.
DB_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://tsv:replace-with-a-long-random-database-password@localhost:5432/tsv?schema=public
APP_URL=http://localhost:3000
# Production must use HTTPS. Keep false for local HTTP development only.
SESSION_SECURE=false
BACKUP_DIR=./backups
