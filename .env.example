# Local development only. Choose a strong, unique DB_PASSWORD before starting Docker.
DB_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://tsv:replace-with-a-long-random-database-password@localhost:5432/tsv?schema=public
APP_URL=http://localhost:3000
# Production must use HTTPS. Keep false for local HTTP development only.
SESSION_SECURE=false
BACKUP_DIR=./backups

# Optional: separate session/direct connection for migrations (never transaction pooler).
# If empty/unset, migrations use DATABASE_URL. Do not use NEXT_PUBLIC_ for secrets.
# DIRECT_URL=postgresql://...
DB_POOL_MAX=3
# Render Free one-time administrator creation; set these only in Render's Environment UI.
# BOOTSTRAP_ADMIN=true
# ADMIN_EMAIL=your-address@example.org
# ADMIN_NAME=Vorname Nachname
# ADMIN_PASSWORD=<choose-a-long-unique-start-password>
